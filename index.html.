
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#F5F9FF">

<title>ERROR YT | Free Fire Gaming</title>
<meta name="description" content="Official ERROR YT gaming website. Free Fire gameplay, headshots, shorts and gaming edits.">

<style>
:root {
  --blue: #087BFF;
  --navy: #10243D;
  --light: #F5F9FF;
  --white: #FFFFFF;
  --muted: #64748B;
  --border: #DCE8F6;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background: var(--light);
  color: var(--navy);
  font-family: Arial, sans-serif;
}

a { text-decoration: none; }

header {
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid var(--border);
  padding: 17px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 25px;
  font-weight: 900;
  letter-spacing: 1px;
}

.logo span { color: var(--blue); }

nav {
  display: flex;
  align-items: center;
  gap: 24px;
}

nav a {
  color: var(--navy);
  font-size: 14px;
  font-weight: bold;
}

nav a:hover { color: var(--blue); }

.menu-btn {
  display: none;
  border: 0;
  background: none;
  color: var(--blue);
  font-size: 27px;
  cursor: pointer;
}

.hero {
  min-height: 570px;
  padding: 100px 7%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  background:
    radial-gradient(circle at 50% 45%,
    #D9EBFF 0%, #F5F9FF 65%);
}

.tag {
  color: var(--blue);
  font-weight: bold;
  letter-spacing: 4px;
  font-size: 12px;
}

.hero h1 {
  font-size: clamp(55px, 11vw, 100px);
  margin: 20px 0;
  font-weight: 900;
  letter-spacing: -3px;
}

.hero h1 span { color: var(--blue); }

.hero h2 {
  font-size: clamp(18px, 4vw, 28px);
  letter-spacing: 3px;
  margin-bottom: 18px;
}

.hero p {
  color: var(--muted);
  max-width: 520px;
  line-height: 1.8;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  margin-top: 30px;
}

.btn {
  display: inline-block;
  background: var(--blue);
  color: white;
  padding: 15px 26px;
  border-radius: 8px;
  font-weight: bold;
  font-size: 14px;
  box-shadow: 0 7px 20px #087BFF30;
  transition: .25s;
}

.btn:hover {
  transform: translateY(-4px);
  background: #0064D6;
}

.btn-outline {
  background: white;
  color: var(--blue);
  border: 1px solid var(--blue);
  box-shadow: none;
}

section {
  padding: 80px 7%;
  text-align: center;
}

.title {
  font-size: 34px;
  margin-bottom: 15px;
  font-weight: 900;
}

.title span { color: var(--blue); }

.subtitle {
  color: var(--muted);
  line-height: 1.8;
  max-width: 650px;
  margin: 0 auto 38px;
}

.about { background: white; }

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.card {
  padding: 35px 22px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: 0 8px 25px #10243D08;
  transition: .25s;
}

.card:hover {
  transform: translateY(-6px);
  border-color: var(--blue);
  box-shadow: 0 12px 30px #087BFF18;
}

.emoji {
  font-size: 42px;
  margin-bottom: 17px;
}

.card h3 {
  color: var(--blue);
  margin-bottom: 12px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.gallery { background: white; }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.gallery-item {
  min-height: 190px;
  border-radius: 13px;
  border: 1px dashed #7CB8FF;
  background: linear-gradient(135deg,#E1EFFF,#F5F9FF);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10px;
  color: var(--blue);
  font-weight: bold;
}

.gallery-item span { font-size: 40px; }

.social {
  background: #E8F2FF;
}

.social-box {
  background: white;
  border: 1px solid var(--border);
  padding: 35px 20px;
  border-radius: 16px;
  max-width: 700px;
  margin: auto;
}

footer {
  padding: 35px 15px;
  text-align: center;
  background: var(--navy);
  color: #DCE8F6;
  line-height: 2;
  font-size: 13px;
}

footer span { color: #55A5FF; }

.top-btn {
  position: fixed;
  bottom: 20px;
  right: 18px;
  width: 45px;
  height: 45px;
  border: none;
  border-radius: 50%;
  background: var(--blue);
  color: white;
  font-size: 20px;
  cursor: pointer;
  display: none;
}

@media(max-width: 700px) {
  header { padding: 16px 5%; }
  .menu-btn { display: block; }

  nav {
    display: none;
    position: absolute;
    top: 65px;
    left: 0;
    right: 0;
    background: white;
    flex-direction: column;
    padding: 25px;
    border-bottom: 1px solid var(--border);
  }

  nav.open { display: flex; }

  nav a { padding: 8px; }

  .hero {
    min-height: 500px;
    padding: 75px 6%;
  }

  section { padding: 65px 6%; }

  .cards { grid-template-columns: 1fr; }

  .gallery-grid { grid-template-columns: 1fr; }

  .title { font-size: 29px; }
}
</style>
</head>

<body>

<header>
  <a class="logo" href="#home">
    ERROR <span>YT.</span>
  </a>

  <button class="menu-btn"
    onclick="toggleMenu()"
    aria-label="Toggle navigation">☰</button>

  <nav id="nav">
    <a href="#home" onclick="closeMenu()">Home</a>
    <a href="#about" onclick="closeMenu()">About</a>
    <a href="#content" onclick="closeMenu()">Content</a>
    <a href="#gallery" onclick="closeMenu()">Gallery</a>
    <a href="#contact" onclick="closeMenu()">Contact</a>
  </nav>
</header>

<main>

<section class="hero" id="home">
  <div class="tag">OFFICIAL FREE FIRE GAMING CHANNEL</div>

  <h1>ERROR <span>YT</span></h1>

  <h2>PLAY. DOMINATE. REPEAT.</h2>

  <p>
    Welcome to my gaming world!
    Discover Free Fire gameplay,
    one-tap headshots, epic moments,
    Shorts and professional gaming edits.
  </p>

  <div class="buttons">
    <a class="btn"
      href="https://youtube.com/@error-yt-0011"
      target="_blank" rel="noopener">
      ▶ SUBSCRIBE ON YOUTUBE
    </a>

    <a class="btn btn-outline"
      href="https://www.instagram.com/error_yt_ff/"
      target="_blank" rel="noopener">
      FOLLOW ON INSTAGRAM
    </a>
  </div>
</section>

<section class="about" id="about">
  <h2 class="title">ABOUT <span>ERROR YT</span></h2>

  <p class="subtitle">
    ERROR YT is a Free Fire gaming content brand.
    Here you'll find exciting gameplay, headshot
    highlights, gaming Shorts and creative edits.
    Join the family and support the journey!
  </p>
</section>

<section id="content">
  <h2 class="title">MY <span>CONTENT</span></h2>

  <p class="subtitle">
    Explore different sides of the ERROR YT gaming world.
  </p>

  <div class="cards">

    <div class="card">
      <div class="emoji">🎯</div>
      <h3>ONE TAP HEADSHOTS</h3>
      <p>Aim, accuracy and amazing headshot moments.</p>
    </div>

    <div class="card">
      <div class="emoji">🔥</div>
      <h3>FREE FIRE GAMEPLAY</h3>
      <p>Epic matches, intense battles and highlights.</p>
    </div>

    <div class="card">
      <div class="emoji">🎬</div>
      <h3>GAMING EDITS</h3>
      <p>Creative edits, posters and gaming Shorts.</p>
    </div>

  </div>
</section>

<section class="gallery" id="gallery">
  <h2 class="title">GAMING <span>GALLERY</span></h2>

  <p class="subtitle">
    Your favourite gaming moments belong here.
    Replace these placeholders with your own images.
  </p>

  <div class="gallery-grid">

    <div class="gallery-item">
      <span>🎮</span>
      ADD GAMEPLAY IMAGE 1
    </div>

    <div class="gallery-item">
      <span>🏆</span>
      ADD WINNING MOMENT 2
    </div>

    <div class="gallery-item">
      <span>🎯</span>
      ADD HEADSHOT IMAGE 3
    </div>

    <div class="gallery-item">
      <span>⚡</span>
      ADD GAMING POSTER 4
    </div>

  </div>
</section>

<section class="social" id="contact">
  <div class="social-box">
    <h2 class="title">JOIN THE <span>ERROR FAMILY</span></h2>

    <p class="subtitle">
      Your support motivates us to create
      more amazing gaming content.
      Subscribe and follow today!
    </p>

    <div class="buttons">
      <a class="btn"
        href="https://youtube.com/@error-yt-0011"
        target="_blank" rel="noopener">
        YOUTUBE
      </a>

      <a class="btn btn-outline"
        href="https://www.instagram.com/error_yt_ff/"
        target="_blank" rel="noopener">
        INSTAGRAM
      </a>
    </div>
  </div>
</section>

</main>

<footer>
  <p>© <span id="year"></span> ERROR YT. All Rights Reserved.</p>
  <p>Made with ❤️ for the gaming community.</p>
  <p>PLAY. DOMINATE. REPEAT.</p>
</footer>

<button class="top-btn" id="topBtn"
  onclick="window.scrollTo({top:0,behavior:'smooth'})"
  aria-label="Back to top">↑</button>

<script>
function toggleMenu() {
  document.getElementById("nav").classList.toggle("open");
}

function closeMenu() {
  document.getElementById("nav").classList.remove("open");
}

document.getElementById("year").textContent =
  new Date().getFullYear();

window.addEventListener("scroll", function() {
  document.getElementById("topBtn").style.display =
    window.scrollY > 300 ? "block" : "none";
});
</script>

</body>
</html>
